# KAU Supabase persistence
# Crie um projeto no Supabase e copie Project URL + service role key.
# A service role fica SOMENTE no servidor/API do Next. Nunca exponha no cliente.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Obrigatorio para login (browser + middleware + sessao).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Auth MVP: desabilite sign-ups no Supabase Dashboard (Authentication > Providers > Email).
# Crie a admin Rayany manualmente e demais usuarios via /admin/users.
