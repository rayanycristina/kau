# KAU Supabase persistence
# Crie um projeto no Supabase e copie Project URL + service role key.
# A service role fica SOMENTE no servidor/API do Next. Nunca exponha no cliente.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Opcional: se ainda nao tiver service role, a API tenta usar anon key.
# Para operacao real, use service role + RLS controlado no backend.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
